# MySQL local
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_DATABASE=dhages_turismo
MYSQL_USER=dhages
MYSQL_PASSWORD=replace-with-a-local-app-password
DATABASE_URL=mysql://dhages:replace-with-a-local-app-password@127.0.0.1:3307/dhages_turismo

# Autenticação administrativa
SESSION_SECRET=generate-at-least-32-random-bytes
ADMIN_INITIAL_NAME=Administrador D'Hages
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=set-a-strong-password-before-seeding

# Uploads
UPLOAD_DIR=./storage/uploads
UPLOAD_BASE_URL=/uploads
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=104857600

# URL pública usada em metadata e compartilhamento
APP_URL=http://localhost:3000

# Use 1 apenas na Vercel quando o deploy deve expor somente o frontend público.
FRONTEND_ONLY=0
